{
  "name": "@meddleware/dev",
  "version": "0.0.23",
  "description": "Meddleware developer documentation site (dev.meddleware.co.uk) — VitePress. Integration guides, design system usage, and Sui development patterns.",
  "homepage": "https://dev.meddleware.co.uk/",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/dev.git"
  },
  "type": "module",
  "files": [
    "docs",
    "!docs/audit",
    "!docs/audit/**",
    "!docs/sui/onchain",
    "!docs/sui/onchain/**",
    "!docs/.vitepress/generated",
    "!docs/.vitepress/generated/**",
    "!docs/.vitepress/cache",
    "!docs/.vitepress/cache/**",
    "!docs/.vitepress/dist",
    "!docs/.vitepress/dist/**",
    "tsconfig.json",
    "CHANGELOG.md",
    "scripts"
  ],
  "scripts": {
    "gen:onchain": "node scripts/gen-onchain.mjs",
    "dev": "npm run gen:onchain && vitepress dev docs",
    "build": "npm run gen:onchain && npm run check:onchain-ids && vitepress build docs && node scripts/check-dist-no-audit.mjs",
    "preview": "vitepress preview docs",
    "type-check": "tsc --noEmit",
    "lint:css": "stylelint \"docs/.vitepress/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"docs/.vitepress/**/*.vue\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "check:licenses": "node scripts/third-party-licenses.mjs --check",
    "check:onchain-ids": "node scripts/check-onchain-ids.mjs",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.10",
    "@meddleware/ui": "^0.1.31"
  },
  "devDependencies": {
    "@meddleware/access-gate-client": "^0.0.9",
    "@meddleware/access-gate-sui": "^0.0.6",
    "@meddleware/nft-gate-client": "^0.0.17",
    "@meddleware/seal-client": "^0.0.20",
    "@meddleware/seal-policies-sui": "^0.0.7",
    "@meddleware/sui-token-template": "^1.0.9",
    "@meddleware/wallet-adapter": "^0.0.17",
    "@meddleware/walrus-client": "^0.0.28",
    "@mysten/seal": "^1.5.0",
    "@mysten/sui": "^2.36.0",
    "@mysten/walrus": "~1.2.35",
    "@types/node": "~25.9.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "html-validate": "^11.16.4",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "~5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
