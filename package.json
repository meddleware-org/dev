{
  "name": "@meddleware/dev",
  "version": "0.0.22",
  "description": "Meddleware developer documentation site (dev.meddleware.co.uk) — VitePress. Integration guides, design system usage, and Sui development patterns.",
  "homepage": "https://dev.meddleware.co.uk/",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/dev.git"
  },
  "type": "module",
  "files": [
    "docs",
    "tsconfig.json",
    "CHANGELOG.md",
    "scripts"
  ],
  "scripts": {
    "gen:onchain": "node scripts/gen-onchain.mjs",
    "dev": "npm run gen:onchain && vitepress dev docs",
    "build": "npm run gen:onchain && vitepress build docs",
    "preview": "vitepress preview docs",
    "type-check": "tsc --noEmit",
    "lint:css": "stylelint \"docs/.vitepress/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"docs/.vitepress/**/*.vue\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "check:licenses": "node scripts/third-party-licenses.mjs --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.9",
    "@meddleware/ui": "^0.1.31"
  },
  "devDependencies": {
    "@meddleware/access-gate-sui": "^0.0.6",
    "@meddleware/seal-policies-sui": "^0.0.7",
    "@meddleware/sui-token-template": "^1.0.7",
    "@types/node": "~24.12.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "html-validate": "^11.16.1",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "postcss": "^8.4.49",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
